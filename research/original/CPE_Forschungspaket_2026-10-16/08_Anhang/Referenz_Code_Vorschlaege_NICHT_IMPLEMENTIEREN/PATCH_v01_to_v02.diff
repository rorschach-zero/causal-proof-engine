+def test_robust_allocation_respects_max_loss_and_caps():
+    R = np.array([[2.0, 0.5], [-0.9, -0.9], [0.1, 0.1]])
+    Q = np.array([[0.3, 0.3, 0.4]])
+    r = robust_allocation(R, Q, gross_cap=0.3, max_loss=0.05, kelly_fraction=1.0)
