diff -ruN -x __pycache__ -x .pytest_cache work_v01/cpe/eprocess.py work_v02/cpe/eprocess.py
--- work_v01/cpe/eprocess.py	1970-01-01 01:00:00.000000000 +0100
+++ work_v02/cpe/eprocess.py	2026-10-16 07:26:32.569554072 +0200
@@ -0,0 +1,128 @@
+"""Commit-before-resolve e-process for pre-registered Brier comparisons (v0.2).
+
+Fixes v0.1 `ChallengerEvidence` (core.py:136-165), which accepted forecast
+probabilities at *resolution* time and therefore could not distinguish a
+prospective forecast from a hindsight one, had no event identity (the same
+outcome could be fed repeatedly), used a static betting fraction, and allowed
+betting_fraction == 1 (absorbing zero).
+
+Statistical statement (unchanged, now enforced by the API):
+  X_t = Brier(baseline_t) - Brier(challenger_t)  in [-1, 1]
+  M_n = prod_{t<=n} (1 + lam_t X_t), lam_t in [0, lam_max], lam_max < 1,
+  lam_t measurable w.r.t. information BEFORE outcome t is revealed.
+Under H0: E[X_t | F_{t-1}] <= 0 for all t, M is a nonnegative supermartingale
+with M_0 = 1 and P(exists n: M_n >= 1/alpha) <= alpha (Ville).
+
+What this does NOT give you: validity if forecasts are edited after commit,
+if the pair (baseline, challenger) is chosen after seeing which pair "won",
+or if the e-value is compared against many alphas chosen post hoc.
+Resolution ORDER matters: events are incorporated in resolution order and
+lam_t is computed from previously resolved events only, so delayed labels
+are handled correctly as long as `resolve` is called once per event.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from datetime import datetime
+from math import isfinite
+from typing import Callable
+
+
+def _aware(dt: datetime) -> bool:
+    return dt.tzinfo is not None and dt.utcoffset() is not None
+
+
+@dataclass(frozen=True)
+class CommittedForecastPair:
+    event_id: str
+    baseline_p: float
+    challenger_p: float
+    committed_at: datetime
+    resolves_not_before: datetime  # earliest time the outcome can be known
+
+
+def grapa_lambda(past_x: list[float], lam_max: float = 0.5, shrink: float = 1.0) -> float:
+    """Predictable betting fraction from PAST increments only.
+
+    Approximate growth-rate-optimal lambda = clip(mean/ (var + mean^2)) shrunk
+    toward 0 for small n. With no history returns 0 (no bet) -> M stays 1.
+    Reference idea: Waudby-Smith & Ramdas, "Estimating means of bounded random
+    variables by betting" (2020, arXiv:2010.09686). UNVERIFIED here beyond the
+    nonnegativity property, which is what validity needs; lambda only affects power.
+    """
+    n = len(past_x)
+    if n < 2:
+        return 0.0
+    m = sum(past_x) / n
+    v = sum((x - m) ** 2 for x in past_x) / (n - 1)
+    denom = v + m * m
+    if denom <= 0:
+        return 0.0
+    lam = m / denom
+    lam *= n / (n + shrink * 10)  # shrink for small samples
+    return float(max(0.0, min(lam_max, lam)))
+
+
+class CommittedEProcess:
+    """E-process over committed (pre-registered) forecast pairs."""
+
+    def __init__(self, lambda_rule: Callable[[list[float]], float] | None = None,
+                 lam_max: float = 0.5) -> None:
+        if not (0.0 <= lam_max < 1.0):
+            raise ValueError('lam_max must be in [0,1); 1 creates an absorbing zero')
+        self.lam_max = lam_max
+        self._rule = lambda_rule or (lambda past: grapa_lambda(past, lam_max=lam_max))
+        self._committed: dict[str, CommittedForecastPair] = {}
+        self._resolved: dict[str, int] = {}
+        self._x_history: list[float] = []
+        self.evalue = 1.0
+        self.max_evalue = 1.0
+
+    # ---- commitment phase -------------------------------------------------
+    def commit(self, pair: CommittedForecastPair) -> None:
+        for p in (pair.baseline_p, pair.challenger_p):
+            if not (isfinite(p) and 0.0 <= p <= 1.0):
+                raise ValueError('Probabilities must be in [0,1]')
+        if not (_aware(pair.committed_at) and _aware(pair.resolves_not_before)):
+            raise ValueError('Timestamps must be timezone-aware')
+        if pair.resolves_not_before <= pair.committed_at:
+            raise ValueError('Forecast must be committed strictly before resolution window')
+        if pair.event_id in self._committed:
+            raise ValueError(f'Event {pair.event_id} already committed; forecasts are immutable')
+        self._committed[pair.event_id] = pair
+
+    # ---- resolution phase -------------------------------------------------
+    def resolve(self, event_id: str, outcome: int, resolved_at: datetime) -> float:
+        if outcome not in (0, 1):
+            raise ValueError('Outcome must be binary')
+        if event_id not in self._committed:
+            raise ValueError(f'No committed forecast for {event_id}: hindsight entry rejected')
+        if event_id in self._resolved:
+            raise ValueError(f'Event {event_id} already resolved: duplicate rejected')
+        pair = self._committed[event_id]
+        if not _aware(resolved_at) or resolved_at < pair.resolves_not_before:
+            raise ValueError('Resolution before the declared resolution window is not allowed')
+        lam = self._rule(list(self._x_history))  # predictable: uses past only
+        if not (0.0 <= lam <= self.lam_max):
+            raise ValueError('lambda rule violated [0, lam_max]')
+        x = (pair.baseline_p - outcome) ** 2 - (pair.challenger_p - outcome) ** 2
+        self.evalue *= (1.0 + lam * x)
+        self.max_evalue = max(self.max_evalue, self.evalue)
+        self._x_history.append(x)
+        self._resolved[event_id] = outcome
+        return self.evalue
+
+    # ---- inference ----------------------------------------------------------
+    def reject_null(self, alpha: float) -> bool:
+        """alpha must be PRE-REGISTERED. Anytime-valid: may be checked at any n."""
+        if not 0 < alpha < 1:
+            raise ValueError('alpha invalid')
+        return self.max_evalue >= 1.0 / alpha  # running max: valid by Ville
+
+    @property
+    def n(self) -> int:
+        return len(self._resolved)
+
+    @property
+    def pending(self) -> int:
+        return len(self._committed) - len(self._resolved)
diff -ruN -x __pycache__ -x .pytest_cache work_v01/cpe/fusion.py work_v02/cpe/fusion.py
--- work_v01/cpe/fusion.py	1970-01-01 01:00:00.000000000 +0100
+++ work_v02/cpe/fusion.py	2026-10-16 07:28:24.993560755 +0200
@@ -0,0 +1,152 @@
+"""Correlation-aware multi-model fusion with explicit abstention (v0.2).
+
+Mandatory inputs per event: an interval forecast from EACH of the three LLM
+researchers (Claude, OpenAI, Gemini) and a Jev triage record. Missing mandatory
+input => decision RE_RESEARCH, never a silent 2-of-3.
+
+Fusion is NOT majority voting:
+  1. Each forecaster's historical standardized errors e_i = (p_i - y) are used to
+     estimate the error correlation matrix R (shrunk toward identity).
+  2. Weights are the minimum-variance pooling weights w = R^-1 1 / (1' R^-1 1),
+     clipped to [0,1] and renormalised (if clipping is needed we fall back to
+     equal weights and flag it). Three models that always agree therefore
+     count roughly as ONE source, not three.
+  3. The fused credal interval is the convex combination of the input intervals.
+  4. Abstention is explicit: large disagreement, wide fused interval, a model's
+     abstention, or Jev flagging the evidence as not a dated primary claim all
+     stop the pipeline with a typed reason.
+
+All thresholds are pre-registered constants (see FusionPolicy); they are not
+tuned on the live ledger.
+
+HYPOTHESIS (untested): that this fusion has lower Brier than the best single
+model on prospectively registered events. See SCIENTIFIC_EXPERIMENTS.md H1/H3.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from enum import Enum
+from typing import Sequence
+import numpy as np
+
+
+class Decision(str, Enum):
+    FORECAST = 'forecast'
+    ABSTAIN = 'abstain'
+    RE_RESEARCH = 're_research'
+
+
+@dataclass(frozen=True)
+class ModelInterval:
+    forecaster: str
+    p_low: float
+    p_high: float
+    abstained: bool = False
+
+    @property
+    def mid(self) -> float:
+        return 0.5 * (self.p_low + self.p_high)
+
+
+@dataclass(frozen=True)
+class JevTriage:
+    """Typed Jev outputs. These are classification probabilities, NOT investment probabilities."""
+    dated_primary_evidence: float      # noul: evidence has date + traceable primary source
+    relevance_to_event: float          # noul: evidence bears on the registered event
+    complement_gap: float              # |p(X) + p(not X) - 1| measured on this call
+
+
+@dataclass(frozen=True)
+class FusionPolicy:
+    required: tuple[str, ...] = ('claude', 'openai', 'gemini')
+    max_disagreement: float = 0.30      # max spread of midpoints before abstain
+    max_fused_width: float = 0.35
+    min_jev_primary: float = 0.60
+    min_jev_relevance: float = 0.50
+    max_jev_complement_gap: float = 0.15
+    shrink_to_identity: float = 0.30    # Ledoit-Wolf style shrinkage weight
+    min_history: int = 20               # below this, equal weights
+
+
+@dataclass(frozen=True)
+class FusionResult:
+    decision: Decision
+    p_low: float
+    p_high: float
+    weights: dict[str, float]
+    disagreement: float
+    effective_models: float
+    reasons: tuple[str, ...]
+
+
+def error_correlation(errors: np.ndarray, shrink: float) -> np.ndarray:
+    """errors: (n_events, n_models) matrix of p_i - y. Returns shrunk correlation."""
+    n, m = errors.shape
+    if n < 2:
+        return np.eye(m)
+    c = np.corrcoef(errors, rowvar=False)
+    c = np.nan_to_num(c, nan=0.0)
+    np.fill_diagonal(c, 1.0)
+    return (1 - shrink) * c + shrink * np.eye(m)
+
+
+def min_variance_weights(R: np.ndarray) -> tuple[np.ndarray, bool]:
+    m = R.shape[0]
+    ones = np.ones(m)
+    try:
+        inv = np.linalg.solve(R, ones)
+    except np.linalg.LinAlgError:
+        return ones / m, True
+    w = inv / inv.sum()
+    if (w < 0).any() or not np.isfinite(w).all():
+        return ones / m, True  # fallback flagged
+    return w, False
+
+
+def effective_models(w: np.ndarray, R: np.ndarray) -> float:
+    return float(w.sum() ** 2 / (w @ R @ w))
+
+
+def fuse(intervals: Sequence[ModelInterval], jev: JevTriage | None,
+         error_history: np.ndarray | None, policy: FusionPolicy = FusionPolicy()) -> FusionResult:
+    reasons: list[str] = []
+    by_name = {iv.forecaster: iv for iv in intervals}
+    missing = [r for r in policy.required if r not in by_name]
+    if missing or jev is None:
+        return FusionResult(Decision.RE_RESEARCH, 0.0, 1.0, {}, 1.0, 0.0,
+                            tuple([f'missing mandatory input: {m}' for m in missing] + ([] if jev else ['missing jev triage'])))
+    if jev.complement_gap > policy.max_jev_complement_gap:
+        reasons.append(f'jev incoherent on this item (complement gap {jev.complement_gap:.2f})')
+    if jev.dated_primary_evidence < policy.min_jev_primary:
+        reasons.append('jev: evidence not a dated primary claim')
+    if jev.relevance_to_event < policy.min_jev_relevance:
+        reasons.append('jev: evidence not relevant to registered event')
+    if reasons:
+        return FusionResult(Decision.RE_RESEARCH, 0.0, 1.0, {}, 1.0, 0.0, tuple(reasons))
+
+    ordered = [by_name[r] for r in policy.required]
+    if any(iv.abstained for iv in ordered):
+        return FusionResult(Decision.ABSTAIN, 0.0, 1.0, {}, 1.0, 0.0,
+                            tuple(f'{iv.forecaster} abstained' for iv in ordered if iv.abstained))
+    m = len(ordered)
+    if error_history is not None and error_history.shape[0] >= policy.min_history and error_history.shape[1] == m:
+        R = error_correlation(error_history, policy.shrink_to_identity)
+    else:
+        R = np.eye(m)
+        reasons.append('insufficient history: equal weights')
+    w, fell_back = min_variance_weights(R)
+    if fell_back:
+        reasons.append('weights fell back to equal (negative or singular solution)')
+    lows = np.array([iv.p_low for iv in ordered]); highs = np.array([iv.p_high for iv in ordered])
+    mids = 0.5 * (lows + highs)
+    p_low = float(w @ lows); p_high = float(w @ highs)
+    disagreement = float(mids.max() - mids.min())
+    n_eff = effective_models(w, R)
+    weights = {iv.forecaster: float(wi) for iv, wi in zip(ordered, w)}
+    if disagreement > policy.max_disagreement:
+        reasons.append(f'disagreement {disagreement:.2f} > {policy.max_disagreement}')
+        return FusionResult(Decision.ABSTAIN, p_low, p_high, weights, disagreement, n_eff, tuple(reasons))
+    if (p_high - p_low) > policy.max_fused_width:
+        reasons.append(f'fused width {p_high - p_low:.2f} > {policy.max_fused_width}')
+        return FusionResult(Decision.ABSTAIN, p_low, p_high, weights, disagreement, n_eff, tuple(reasons))
+    return FusionResult(Decision.FORECAST, p_low, p_high, weights, disagreement, n_eff, tuple(reasons))
diff -ruN -x __pycache__ -x .pytest_cache work_v01/cpe/jev_adapter.py work_v02/cpe/jev_adapter.py
--- work_v01/cpe/jev_adapter.py	1970-01-01 01:00:00.000000000 +0100
+++ work_v02/cpe/jev_adapter.py	2026-10-16 07:28:54.653562518 +0200
@@ -0,0 +1,138 @@
+"""Typed TypeSafe Jev adapter (v0.2). Schema verified against the live OpenAPI
+document at https://api.typesafe.ai/openapi.json (title 'TypeSafe', version
+0.2.0, fetched 2026-10-16): POST /v1/systemone with {model, state, questions};
+response {model, answers{name -> {type, noul|choice|score...}}, usage}.
+GET /v1/models lists model names with release_date.
+
+Design rules:
+  * Jev never sees broker credentials, account data or order drafts.
+  * Every call is recorded with origin timestamps and the model name RETURNED
+    (the alias 'jev-latest' can silently change; the response's `model` is
+    the version of record).
+  * Every noul question is asked in both polarities; the complement gap
+    |p + q - 1| is recorded. Published independent evaluation (arXiv:2609.33209)
+    reports a mean gap of 0.064 on complement pairs; items with a large gap are
+    treated as unreliable rather than averaged.
+  * Jev probabilities are triage/classification signals. They become inputs to
