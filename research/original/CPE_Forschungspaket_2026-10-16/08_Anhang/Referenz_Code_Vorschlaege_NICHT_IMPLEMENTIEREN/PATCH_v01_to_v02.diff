+JEV_URL = 'https://api.typesafe.ai/v1/systemone'
+JEV_MODELS_URL = 'https://api.typesafe.ai/v1/models'
+
+
+class Transport(Protocol):
+    def __call__(self, url: str, headers: dict, body: dict, timeout: float) -> tuple[int, dict]: ...
+
