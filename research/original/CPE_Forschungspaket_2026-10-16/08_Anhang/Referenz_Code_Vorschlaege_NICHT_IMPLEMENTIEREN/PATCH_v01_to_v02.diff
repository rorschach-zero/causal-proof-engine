+def test_jev_adapter_parses_and_rejects_malformed():
+    good = {'model': 'jev-2026-09-15', 'answers': {'q': {'type': 'noul', 'noul': 0.8}, 'q_not': {'type': 'noul', 'noul': 0.25}},
+            'usage': {'input_tokens': 100, 'output_tokens': 2}}
